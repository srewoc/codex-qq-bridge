# Usually generated by `uv run codex-qq onboard` into a 0600 local file.
# Environment variables override that file when explicitly set.
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_BOT_OWNER_OPENID=
CODEX_QQ_KITTY_COMMAND=kitten
CODEX_QQ_INTERACTION_TIMEOUT_SECONDS=600
CODEX_QQ_SCREEN_MAX_CHARS=6000
CODEX_QQ_MESSAGE_CHUNK_SIZE=1800
